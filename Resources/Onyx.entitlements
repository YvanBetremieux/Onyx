<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>       <true/>
  <key>com.apple.security.device.microphone</key>        <true/>
  <!--
    Local ad-hoc / self-signed builds cannot satisfy hardened-runtime library
    validation for embedded 3rd-party frameworks (Sparkle) because there is
    no real Team ID to compare against. This entitlement bypasses that check
    for dev builds only.
  -->
  <key>com.apple.security.cs.disable-library-validation</key> <true/>
</dict>
</plist>
